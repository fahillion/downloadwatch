# DownloadWatch for Plex settings. Copy to .env and edit. Never commit .env (it may hold secrets).

# Your Plex Media Server's LAN address (required)
PLEX_URL=http://192.168.1.10:32400

# Dashboard login (strongly recommended: the history shows what named people downloaded)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-something-long

# Timezone for dates on the dashboard and in CSV exports (tz database name)
TIMEZONE=America/New_York

# Optional: set a Plex token here instead of using "Sign in with Plex" on the dashboard
# PLEX_TOKEN=

# Optional: how often to check Plex as a backstop to the live feed (seconds)
# POLL_INTERVAL_SECONDS=5

# Optional: links shown in the top bar, e.g. to your other dashboards
# NAV_LINKS=Plex=http://192.168.1.10:32400/web,Tautulli=http://192.168.1.10:8181

# Optional: a reverse proxy in front already asks for a login (disables the built-in one)
# AUTH_DISABLED=true

# Optional: try it with made-up data, no Plex needed
# DEMO=true
